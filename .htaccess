# 301-Weiterleitung der gesamten Domain sidebyside-bbq.de
# Ziel: https://gebaeudewerke.de/hausmeisterservice.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^.*$ https://gebaeudewerke.de/hausmeisterservice.html [R=301,L]
</IfModule>

# Fallback, falls mod_rewrite nicht verfuegbar ist
<IfModule !mod_rewrite.c>
  <IfModule mod_alias.c>
    RedirectMatch 301 ^/.*$ https://gebaeudewerke.de/hausmeisterservice.html
  </IfModule>
</IfModule>
